{
  "name": "icemetrics",
  "version": "0.1.0",
  "description": "Production-style NHL analytics platform",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @icemetrics/api",
    "db:migrate": "npm run db:migrate --workspace @icemetrics/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @icemetrics/api",
    "db:reset": "npm run db:reset --workspace @icemetrics/api",
    "db:seed": "npm run db:seed --workspace @icemetrics/api",
    "deployment:check": "node scripts/check-deployment-config.mjs",
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @icemetrics/api",
    "dev:web": "npm run dev --workspace @icemetrics/web",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait postgres",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jobs:dispatch": "npm run jobs:dispatch --workspace @icemetrics/api --",
    "jobs:health": "npm run jobs:health --workspace @icemetrics/api --",
    "jobs:replay": "npm run jobs:replay --workspace @icemetrics/api --",
    "jobs:run": "npm run jobs:run --workspace @icemetrics/api --",
    "lint": "npm run lint --workspaces --if-present",
    "openapi:check": "npm run build --workspace @icemetrics/api && node scripts/check-openapi.mjs",
    "openapi:generate": "npm run openapi:generate --workspace @icemetrics/api && node scripts/generate-openapi-client.mjs",
    "ops:rehearse-restore": "node scripts/rehearse-database-restore.mjs",
    "security:audit": "npm audit --audit-level=critical",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "test": "npm run test:unit",
    "test:e2e": "npm run test:e2e --workspace @icemetrics/web",
    "test:integration": "npm run test:integration --workspace @icemetrics/api",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run db:generate && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run openapi:check && npm run deployment:check && npm run build"
  },
  "devDependencies": {
    "concurrently": "10.0.3",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  },
  "allowScripts": {
    "@prisma/engines@7.3.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "prisma@7.3.0": true,
    "ssh2": false
  }
}
