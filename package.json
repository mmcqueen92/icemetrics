{
  "name": "icemetrics",
  "version": "0.1.0",
  "description": "Production-style NHL analytics platform",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:generate": "node scripts/pass-not-ready.mjs \"Pass 3\" \"database generation\"",
    "db:migrate": "node scripts/pass-not-ready.mjs \"Pass 3\" \"database migrations\"",
    "db:migrate:deploy": "node scripts/pass-not-ready.mjs \"Pass 3\" \"deployed database migrations\"",
    "db:reset": "node scripts/pass-not-ready.mjs \"Pass 3\" \"local database reset\"",
    "db:seed": "node scripts/pass-not-ready.mjs \"Pass 3\" \"database seeding\"",
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @icemetrics/api",
    "dev:web": "npm run dev --workspace @icemetrics/web",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait postgres",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jobs:dispatch": "node scripts/pass-not-ready.mjs \"Pass 6\" \"job dispatch\"",
    "jobs:replay": "node scripts/pass-not-ready.mjs \"Pass 6\" \"raw payload replay\"",
    "jobs:run": "node scripts/pass-not-ready.mjs \"Pass 6\" \"individual jobs\"",
    "lint": "npm run lint --workspaces --if-present",
    "openapi:check": "npm run build --workspace @icemetrics/api && node scripts/check-openapi.mjs",
    "openapi:generate": "npm run openapi:generate --workspace @icemetrics/api",
    "security:audit": "npm audit --audit-level=critical",
    "test": "npm run test:unit",
    "test:e2e": "node scripts/pass-not-ready.mjs \"Pass 10\" \"browser end-to-end testing\"",
    "test:integration": "npm run test:integration --workspace @icemetrics/api",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run openapi:check && npm run build"
  },
  "devDependencies": {
    "concurrently": "10.0.3",
    "prettier": "3.9.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "ssh2": false
  }
}
